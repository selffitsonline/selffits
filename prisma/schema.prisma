datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum AgeGroup {
  KIDS
  ADULTS
  LADIES_ONLY
}

enum ProgramCategory {
  MARTIAL_ARTS
  FITNESS_WEIGHT_LOSS
  FITNESS_HIIT
}

enum MembershipTier {
  YELLOW_BELT
  BLUE_BELT
  PURPLE_BELT
  BROWN_BELT
  CHALLENGE_8
  CHALLENGE_24
  CHALLENGE_48
  TRANSFORMATION_96
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ContactStatus {
  NEW
  RESOLVED
}

enum ExaminationStatus {
  PENDING
  PASSED
  FAILED
  ABSENT
}


model User {
  id            String          @id @default(cuid())
  firstName     String?
  lastName      String?
  name          String
  email         String          @unique
  passwordHash  String?
  role          Role            @default(STUDENT)
  isBlocked     Boolean         @default(false)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  studentProfile StudentProfile?
  enrollments    Enrollment[]
  payments       Payment[]
  certificates   Certificate[]  @relation("StudentCertificates")
  issuedCerts    Certificate[]  @relation("AdminIssuedCertificates")
  notifications  Notification[]
  batchStudents  BatchStudent[]
  examinations   Examination[]
  beltProgressions BeltProgression[]


  @@index([email])
  @@index([role])
  @@index([isBlocked])
}

model StudentProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?
  country          String?
  city             String?
  emergencyContact String?
  dateOfBirth      DateTime?
  ageGroup         AgeGroup?
  age              Int?
  gender           String?
  currentBelt      String    @default("White Belt")
  beltAwardedAt    DateTime?
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model Program {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  category       ProgramCategory
  targetAudience AgeGroup
  description    String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  membershipPlans MembershipPlan[]
  certificates    Certificate[]
  batches         Batch[]
  examinations    Examination[]
}

model MembershipPlan {
  id             String         @id @default(cuid())
  programId      String
  program        Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  name           String
  tierType       MembershipTier
  durationMonths Int
  totalClasses   Int
  priceINR       Decimal        @db.Decimal(10, 2)
  priceUSD       Decimal        @db.Decimal(10, 2)
  isActive       Boolean        @default(true)

  enrollments Enrollment[]
  batches     Batch[]
}

model Enrollment {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipPlanId   String
  membershipPlan     MembershipPlan   @relation(fields: [membershipPlanId], references: [id])
  classTiming        String?          // e.g. "03:30 PM to 04:15 PM (GMT)"
  daysPerWeek        Int?
  selectedDays       Json?
  selectedBatch      String?
  monthlyPrice       Decimal?         @db.Decimal(10, 2)
  includeDietNutrition Boolean        @default(false)
  dietNutritionPrice   Decimal?         @db.Decimal(10, 2)
  timezone           String?          @default("GMT (UTC+0)")
  startDate          DateTime         @default(now())
  endDate            DateTime
  totalClassesGranted Int
  remainingClasses   Int
  status             EnrollmentStatus @default(ACTIVE)
  createdAt          DateTime         @default(now())

  payments Payment[]

  @@index([userId, status])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  enrollmentId      String?
  enrollment        Enrollment?   @relation(fields: [enrollmentId], references: [id])
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        // "INR" | "USD"
  status            PaymentStatus @default(PENDING)
  rawWebhookPayload Json?
  createdAt         DateTime      @default(now())

  @@index([userId])
  @@index([razorpayOrderId])
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("StudentCertificates", fields: [userId], references: [id], onDelete: Cascade)
  programId         String
  program           Program  @relation(fields: [programId], references: [id])
  title             String
  certificateNumber String   @unique
  fileKey           String
  issuedDate        DateTime @default(now())
  issuedByUserId    String
  issuedByUser      User     @relation("AdminIssuedCertificates", fields: [issuedByUserId], references: [id])
  beltName          String?
  beltProgression   BeltProgression?

  @@index([userId])
}

model Examination {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId        String?
  program          Program?          @relation(fields: [programId], references: [id])
  targetBelt       String
  examDate         DateTime
  status           ExaminationStatus @default(PENDING)
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  beltProgressions BeltProgression[]

  @@index([userId])
  @@index([status])
}

model BeltProgression {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examinationId   String?
  examination     Examination? @relation(fields: [examinationId], references: [id])
  previousBelt    String?
  currentBelt     String
  awardDate       DateTime     @default(now())
  certificateId  String?      @unique
  certificate     Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime     @default(now())

  @@index([userId])
}


model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ContactInquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model WebsiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

enum CoachAppStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model CoachApplication {
  id                    String         @id @default(cuid())
  // 1. Personal Info
  fullName              String
  dateOfBirth           String?
  gender                String?
  nationality           String?
  phone                 String
  countryCallingCode    String?
  email                 String
  location              String?
  profilePhotoUrl       String?

  // Belt Level & Years of Experience
  beltLevel             String?
  yearsOfExperience     String?

  // 2. Coaching Discipline
  disciplines           Json

  // 3. Qualifications & Certifications
  highestRank           String?
  certificationName     String?
  issuingOrganization   String?
  yearObtained          String?
  certificateNumber     String?
  certificateUploadUrl String?

  // 4. Coaching Experience
  totalExperience       String?
  previousAcademy       String?
  coachingBio           String?
  targetAgeGroups       Json

  // 5. Specializations
  specializations       Json

  // 6. Online Coaching
  hasOnlineExperience   String?
  preferredPlatform     String?
  isLiveClassAvailable  String?

  // 7. Availability
  availability          Json

  // 8. Coach Introduction
  aboutSelf             String?
  whyJoinSelffits       String?
  whatMakesGoodCoach    String?

  // 9. Portfolio & Social Media
  instagramUrl          String?
  facebookUrl           String?
  youtubeUrl            String?
  websiteUrl            String?
  trainingVideoUrl      String?

  // 10. Documents
  resumeUrl             String?
  qualificationCertsUrl String?
  licenseUrl            String?
  idPassportUrl         String?

  // 11. Declaration
  agreedDeclaration     Boolean        @default(true)
  status                CoachAppStatus @default(PENDING)
  createdAt             DateTime       @default(now())

  batches               Batch[]

  @@index([email])
  @@index([status])
}

enum BatchStatus {
  ACTIVE
  FULL
  INACTIVE
}

model Batch {
  id               String           @id @default(cuid())
  batchId          String           @unique @default(cuid())
  name             String
  programId        String
  program          Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  membershipPlanId String?
  membershipPlan   MembershipPlan?  @relation(fields: [membershipPlanId], references: [id])
  beltLevel        String           @default("Yellow Belt")
  coachId          String
  coach            CoachApplication @relation(fields: [coachId], references: [id])

  dayCombination   String           // "Sunday & Wednesday" | "Monday & Thursday" | "Saturday & Tuesday"
  timeSlot         String           // "Morning" | "Evening" | "Night"
  clockTiming      String           // e.g. "09:00 AM to 09:45 AM (GMT)"
  meetingUrl       String?          // Google Meet / Zoom URL e.g. "https://meet.google.com/abc-defg-hij"
  examDate         DateTime?        // Scheduled examination date for this batch

  maxCapacity      Int              @default(8)
  status           BatchStatus      @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  students         BatchStudent[]

  @@index([programId])
  @@index([coachId])
  @@index([status])
}

model BatchStudent {
  id         String   @id @default(cuid())
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([batchId, userId])
  @@index([userId])
}
